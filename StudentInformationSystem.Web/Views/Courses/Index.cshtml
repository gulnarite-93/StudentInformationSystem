@model IEnumerable<StudentInformationSystem.Web.Models.CourseViewModel>
@{
    ViewData["Title"] = "Kurs Kataloqu (F2)";
    var terms = ViewBag.Terms as List<StudentInformationSystem.Web.Models.TermViewModel> ?? new();
    var programmes = ViewBag.Programmes as List<StudentInformationSystem.Web.Models.ProgrammeViewModel> ?? new();
    string? currentSearch = ViewBag.CurrentSearch as string;
    int? currentTermId = ViewBag.CurrentTermId as int?;
    int? currentProgrammeId = ViewBag.CurrentProgrammeId as int?;
}

<div class="mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold text-dark mb-1"><i class="bi bi-journal-text text-primary me-2"></i>Kurs Kataloqu (F2)</h2>
            <p class="text-muted mb-0">Tədris müəssisəsi üzrə bütün aktiv və mövcud kursların ümumi kataloqu.</p>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Admin" asp-action="Courses" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-gear me-1"></i> Kursları İdarə Et
            </a>
        }
    </div>
</div>

<!-- Axtarış və Filtrlər -->
<div class="card shadow-sm border-0 mb-4 rounded-3">
    <div class="card-body p-3">
        <form asp-controller="Courses" asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" value="@currentSearch" class="form-control" placeholder="Kurs adı, kodu və ya təsvir ilə axtar..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="termId" class="form-select">
                    <option value="">-- Bütün Semestrlər --</option>
                    @foreach (var t in terms)
                    {
                        <option value="@t.Id" selected="@(currentTermId == t.Id)">@t.Name @(t.IsActive ? "(Aktiv)" : "")</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select name="programmeId" class="form-select">
                    <option value="">-- Bütün İxtisaslar --</option>
                    @foreach (var p in programmes)
                    {
                        <option value="@p.Id" selected="@(currentProgrammeId == p.Id)">@p.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-1 d-flex gap-1">
                <button type="submit" class="btn btn-primary w-100 fw-semibold" title="Filtrlə">
                    <i class="bi bi-funnel"></i>
                </button>
                @if (!string.IsNullOrEmpty(currentSearch) || currentTermId.HasValue || currentProgrammeId.HasValue)
                {
                    <a asp-controller="Courses" asp-action="Index" class="btn btn-outline-secondary" title="Sıfırla">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Kurs Kartları Siyahısı -->
@if (!Model.Any())
{
    <div class="card shadow-sm border-0 rounded-3 text-center py-5">
        <div class="card-body">
            <i class="bi bi-journal-x display-3 text-muted"></i>
            <h5 class="mt-3 text-muted">Axtarışa uyğun heç bir kurs tapılmadı.</h5>
            <a asp-controller="Courses" asp-action="Index" class="btn btn-outline-primary btn-sm mt-2">Bütün Kataloqa Bax</a>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var c in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0 rounded-3 hover-shadow transition">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-secondary font-monospace px-2 py-1 fs-6">@c.Code</span>
                            <span class="badge bg-primary rounded-pill px-3 py-1">@c.Credits KREDİT</span>
                        </div>
                        <h5 class="card-title fw-bold text-dark mb-2">@c.Name</h5>
                        <p class="card-text text-muted small flex-grow-1">
                            @(string.IsNullOrEmpty(c.Description) ? "Kurs haqqında əlavə təsvir qeyd edilməyib." : (c.Description.Length > 110 ? c.Description.Substring(0, 107) + "..." : c.Description))
                        </p>

                        <hr class="my-2" />

                        <div class="small mb-1">
                            <span class="text-muted"><i class="bi bi-diagram-3 me-1"></i>İxtisas:</span>
                            <strong class="text-dark">@c.ProgrammeName</strong>
                        </div>
                        <div class="small mb-1">
                            <span class="text-muted"><i class="bi bi-calendar3 me-1"></i>Dövr:</span>
                            <span>@c.TermName</span>
                            @if (c.IsTermActive)
                            {
                                <span class="badge bg-success-subtle text-success ms-1">Aktiv</span>
                            }
                        </div>
                        <div class="small mb-3">
                            <span class="text-muted"><i class="bi bi-person-video3 me-1"></i>Müəllim:</span>
                            @if (!string.IsNullOrEmpty(c.TeacherName))
                            {
                                <strong class="text-dark">@(c.TeacherTitle ?? "") @c.TeacherName</strong>
                            }
                            else
                            {
                                <span class="text-muted fst-italic">Təyin olunmayıb</span>
                            }
                        </div>

                        <div class="mt-auto">
                            <a asp-controller="Courses" asp-action="Details" asp-route-id="@c.Id" class="btn btn-outline-primary btn-sm w-100 fw-semibold">
                                <i class="bi bi-info-circle me-1"></i> Ətraflı Məlumat
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
