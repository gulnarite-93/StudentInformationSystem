@model StudentInformationSystem.Web.Models.LessonSessionFormViewModel
@{
    var actionName = Model.IsEditMode ? "EditAttendanceSession" : "CreateAttendanceSession";
    var pageTitle = Model.IsEditMode ? "Davamiyyəti Redaktə Et" : "Yeni Dərs Sessiyası";
    ViewData["Title"] = $"{pageTitle} - {Model.CourseCode}";
}

<div class="mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Attendance">Davamiyyət</a></li>
                    <li class="breadcrumb-item"><a asp-action="AttendanceSessions" asp-route-courseId="@Model.CourseId">@Model.CourseCode</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@pageTitle</li>
                </ol>
            </nav>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi @(Model.IsEditMode ? "bi-pencil-square text-primary" : "bi-plus-circle text-success") me-2"></i>@pageTitle
            </h2>
            <p class="text-muted mb-0">
                <strong>@Model.CourseCode - @Model.CourseName</strong> kursu üzrə dərsin tarixi, mövzusu və tələbələrin davamiyyət qeydləri.
            </p>
        </div>
        <a asp-action="AttendanceSessions" asp-route-courseId="@Model.CourseId" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Sessiyalar Siyahısına Qayıt
        </a>
    </div>
</div>

<form asp-action="@actionName" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="CourseId" />
    <input type="hidden" asp-for="CourseCode" />
    <input type="hidden" asp-for="CourseName" />
    @if (Model.OriginalLessonDate.HasValue)
    {
        <input type="hidden" name="OriginalLessonDate" value="@Model.OriginalLessonDate.Value.ToString("yyyy-MM-dd")" />
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Bağla"></button>
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger shadow-sm">
            <div asp-validation-summary="All" class="text-danger mb-0"></div>
        </div>
    }

    <!-- Sessiya Məlumatları Kartı -->
    <div class="card shadow-sm border-0 rounded-3 mb-4 border-top border-primary border-4">
        <div class="card-body p-4">
            <h5 class="fw-bold text-dark mb-3">
                <i class="bi bi-info-circle text-primary me-2"></i>Dərs Haqqında Məlumat
            </h5>

            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Dərsin Tarixi <span class="text-danger">*</span></label>
                    <input type="date" asp-for="LessonDate" class="form-control" required />
                    <span asp-validation-for="LessonDate" class="text-danger small"></span>
                </div>
                <div class="col-md-8">
                    <label class="form-label fw-semibold">Dərsin Mövzusu <span class="text-danger">*</span></label>
                    <input type="text" asp-for="LessonTopic" class="form-control" 
                           placeholder="məs: Mühazirə 3: Relyasiyalı cədvəllər və xarici açarlar" required />
                    <span asp-validation-for="LessonTopic" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Tələbələrin Davamiyyət Cədvəli -->
    <div class="card shadow-sm border-0 rounded-3 mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <div>
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-people-fill text-success me-2"></i>Tələbə Davamiyyəti
                </h5>
                <small class="text-muted">Kursa qeydiyyatdan keçmiş @Model.Records.Count tələbə</small>
            </div>
            <div>
                <button type="button" class="btn btn-outline-success btn-sm fw-semibold" onclick="setAllAttendance('Present')">
                    <i class="bi bi-check-all me-1"></i> Hamını "Gəldi" Et
                </button>
                <button type="button" class="btn btn-outline-danger btn-sm fw-semibold ms-1" onclick="setAllAttendance('Absent')">
                    <i class="bi bi-x-circle me-1"></i> Hamını "Qayıb" Et
                </button>
            </div>
        </div>

        <div class="card-body p-0">
            @if (!Model.Records.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-person-x display-4 text-muted"></i>
                    <h5 class="mt-3 text-dark fw-bold">Bu kursa qeydiyyatdan keçmiş tələbə tapılmadı</h5>
                    <p class="text-muted small">Davamiyyət yazmaq üçün əvvəlcə kursa tələbə qeydiyyatı aparılmalıdır.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4" style="width: 50px;">#</th>
                                <th style="width: 130px;">Tələbə Nömrəsi</th>
                                <th>Adı, Soyadı</th>
                                <th style="width: 320px;">Davamiyyət Statusu</th>
                                <th style="width: 250px;" class="pe-4">Qeyd (İstəyə bağlı)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Records.Count; i++)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-muted">@(i + 1)</td>
                                    <td>
                                        <span class="badge bg-secondary font-monospace px-2 py-1">
                                            @(string.IsNullOrEmpty(Model.Records[i].StudentNumber) ? "Yoxdur" : Model.Records[i].StudentNumber)
                                        </span>
                                        <input type="hidden" name="Records[@i].StudentId" value="@Model.Records[i].StudentId" />
                                        <input type="hidden" name="Records[@i].StudentName" value="@Model.Records[i].StudentName" />
                                        <input type="hidden" name="Records[@i].StudentNumber" value="@Model.Records[i].StudentNumber" />
                                    </td>
                                    <td>
                                        <strong class="text-dark">@Model.Records[i].StudentName</strong>
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group" aria-label="Status">
                                            <input type="radio" class="btn-check status-radio status-present" 
                                                   name="Records[@i].Status" id="status-present-@i" 
                                                   value="Present" @(Model.Records[i].Status == "Present" ? "checked" : "") />
                                            <label class="btn btn-outline-success btn-sm px-3" for="status-present-@i">
                                                <i class="bi bi-check-circle me-1"></i> Gəldi
                                            </label>

                                            <input type="radio" class="btn-check status-radio status-absent" 
                                                   name="Records[@i].Status" id="status-absent-@i" 
                                                   value="Absent" @(Model.Records[i].Status == "Absent" ? "checked" : "") />
                                            <label class="btn btn-outline-danger btn-sm px-3" for="status-absent-@i">
                                                <i class="bi bi-x-circle me-1"></i> Qayıb
                                            </label>

                                            <input type="radio" class="btn-check status-radio status-excused" 
                                                   name="Records[@i].Status" id="status-excused-@i" 
                                                   value="Excused" @(Model.Records[i].Status == "Excused" ? "checked" : "") />
                                            <label class="btn btn-outline-warning btn-sm px-3" for="status-excused-@i">
                                                <i class="bi bi-info-circle me-1"></i> İcazəli
                                            </label>
                                        </div>
                                    </td>
                                    <td class="pe-4">
                                        <input type="text" name="Records[@i].Note" value="@Model.Records[i].Note" 
                                               class="form-control form-control-sm" placeholder="Məs: Həkim arayışı var" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Təsdiq və Yadda Saxla Düymələri -->
    <div class="d-flex justify-content-between align-items-center mb-5">
        <a asp-action="AttendanceSessions" asp-route-courseId="@Model.CourseId" class="btn btn-outline-secondary">
            <i class="bi bi-x-lg me-1"></i> İmtina Et
        </a>
        <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold" @(!Model.Records.Any() ? "disabled" : "")>
            <i class="bi bi-save me-1"></i> Davamiyyət Qeydlərini Yadda Saxla
        </button>
    </div>
</form>

@section Scripts {
    <script>
        function setAllAttendance(status) {
            if (status === 'Present') {
                document.querySelectorAll('.status-present').forEach(function(radio) {
                    radio.checked = true;
                });
            } else if (status === 'Absent') {
                document.querySelectorAll('.status-absent').forEach(function(radio) {
                    radio.checked = true;
                });
            }
        }
    </script>
}
