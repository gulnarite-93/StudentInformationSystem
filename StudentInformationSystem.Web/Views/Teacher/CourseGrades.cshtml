@model StudentInformationSystem.Web.Models.CourseGradesViewModel
@{
    ViewData["Title"] = $"{Model.CourseCode} - Qiymətləndirmə Cədvəli";
}

<div class="container-fluid py-3">
    <!-- Başlıq və Geri Keçid -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-action="Grades" class="text-decoration-none">Qiymətləndirmə</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Model.CourseCode</li>
                </ol>
            </nav>
            <h2 class="fw-bold text-dark mb-0">
                <span class="badge bg-primary font-monospace me-2">@Model.CourseCode</span>@Model.CourseName
            </h2>
        </div>
        <a asp-action="Grades" class="btn btn-outline-secondary rounded-3">
            <i class="bi bi-arrow-left me-1"></i> Bütün Fənlər
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Bağla"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Bağla"></button>
        </div>
    }

    <!-- Fənn Məlumatları Kartı -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-primary-subtle p-3 text-primary me-3">
                        <i class="bi bi-mortarboard-fill fs-4"></i>
                    </div>
                    <div>
                        <small class="text-muted text-uppercase fw-bold">Akademik Kredit</small>
                        <h4 class="fw-bold mb-0">@Model.Credits Kredit</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-info-subtle p-3 text-info me-3">
                        <i class="bi bi-people-fill fs-4"></i>
                    </div>
                    <div>
                        <small class="text-muted text-uppercase fw-bold">Tələbə Sayı</small>
                        <h4 class="fw-bold mb-0">@Model.GradedStudentsCount / @Model.EnrolledStudentsCount Qiymətləndirilib</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-success-subtle p-3 text-success me-3">
                        <i class="bi bi-bar-chart-fill fs-4"></i>
                    </div>
                    <div>
                        <small class="text-muted text-uppercase fw-bold">Orta Bal</small>
                        <h4 class="fw-bold mb-0">@Model.AverageScore / 100</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-warning-subtle p-3 text-warning me-3">
                        <i class="bi bi-calendar-event-fill fs-4"></i>
                    </div>
                    <div>
                        <small class="text-muted text-uppercase fw-bold">Semestr</small>
                        <h6 class="fw-bold mb-0 text-truncate" title="@Model.TermName">@Model.TermName</h6>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tələbələrin Qiymət Cədvəli -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="fw-bold text-dark mb-0">
                <i class="bi bi-table me-2 text-primary"></i>Tələbələrin Qiymət Jurnalı
            </h5>
            <span class="badge bg-light text-muted border px-3 py-2 rounded-pill">
                Toplam @Model.Students.Count tələbə
            </span>
        </div>
        <div class="card-body p-0">
            @if (!Model.Students.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-people display-4 text-muted"></i>
                    <h5 class="fw-bold text-dark mt-3">Bu kursa qeydiyyatdan keçmiş tələbə yoxdur</h5>
                    <p class="text-muted small">Tələbələr kursa yazıldıqdan sonra qiymətləndirmə siyahısında görünəcəklər.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4" style="width: 50px;">#</th>
                                <th style="width: 130px;">Tələbə №</th>
                                <th>Adı, Soyadı</th>
                                <th class="text-center" style="width: 100px;">Kollokvium</th>
                                <th class="text-center" style="width: 100px;">Tapşırıq</th>
                                <th class="text-center" style="width: 100px;">İmtahan</th>
                                <th class="text-center" style="width: 110px;">Yekun Bal</th>
                                <th class="text-center" style="width: 90px;">Hərf</th>
                                <th class="text-center" style="width: 90px;">GPA (4.0)</th>
                                <th class="text-center" style="width: 110px;">Status</th>
                                <th class="pe-4 text-end" style="width: 140px;">Əməliyyat</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Students.Count; i++)
                            {
                                var student = Model.Students[i];
                                <tr>
                                    <td class="ps-4 fw-bold text-muted">@(i + 1)</td>
                                    <td>
                                        <span class="badge bg-secondary font-monospace px-2 py-1">
                                            @(string.IsNullOrEmpty(student.StudentNumber) ? "Yoxdur" : student.StudentNumber)
                                        </span>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">@student.StudentName</div>
                                        <small class="text-muted">@student.Email</small>
                                        @if (!string.IsNullOrEmpty(student.Feedback))
                                        {
                                            <div class="small text-info mt-1 fst-italic">
                                                <i class="bi bi-chat-left-text me-1"></i>"@student.Feedback"
                                            </div>
                                        }
                                    </td>
                                    <td class="text-center fw-semibold">
                                        @(student.MidtermScore.HasValue ? student.MidtermScore.Value.ToString("0.##") : "-")
                                    </td>
                                    <td class="text-center fw-semibold">
                                        @(student.AssignmentScore.HasValue ? student.AssignmentScore.Value.ToString("0.##") : "-")
                                    </td>
                                    <td class="text-center fw-semibold">
                                        @(student.FinalScore.HasValue ? student.FinalScore.Value.ToString("0.##") : "-")
                                    </td>
                                    <td class="text-center">
                                        @if (student.HasGrade && student.TotalScore.HasValue)
                                        {
                                            <span class="fw-bold fs-6 @(student.TotalScore.Value >= 51 ? "text-success" : "text-danger")">
                                                @student.TotalScore.Value.ToString("0.##")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border">Qiymətləndirilməyib</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (student.HasGrade && !string.IsNullOrEmpty(student.LetterGrade))
                                        {
                                            <span class="badge @(student.LetterGrade == "A" ? "bg-success" : student.LetterGrade == "B" ? "bg-primary" : student.LetterGrade == "C" ? "bg-info" : student.LetterGrade == "D" || student.LetterGrade == "E" ? "bg-warning text-dark" : "bg-danger") px-2 py-1 fs-6">
                                                @student.LetterGrade
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td class="text-center fw-bold">
                                        @(student.HasGrade && student.GradePoint.HasValue ? student.GradePoint.Value.ToString("0.00") : "-")
                                    </td>
                                    <td class="text-center">
                                        @if (student.HasGrade && student.TotalScore.HasValue)
                                        {
                                            if (student.TotalScore.Value >= 51.00m)
                                            {
                                                <span class="badge bg-success-subtle text-success px-2 py-1 rounded-pill">
                                                    <i class="bi bi-check-circle me-1"></i>Məqbul
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger px-2 py-1 rounded-pill">
                                                    <i class="bi bi-x-circle me-1"></i>Kəsr (F)
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary px-2 py-1 rounded-pill">Gözləyir</span>
                                        }
                                    </td>
                                    <td class="pe-4 text-end">
                                        <button type="button" class="btn btn-sm @(student.HasGrade ? "btn-outline-primary" : "btn-primary") rounded-pill px-3 fw-semibold"
                                                onclick="openGradeModal(@student.EnrollmentId, '@student.StudentName', @(student.MidtermScore ?? 0), @(student.AssignmentScore ?? 0), @(student.FinalScore ?? 0), @(student.TotalScore ?? 0), '@(student.Feedback?.Replace("'", "\\'") ?? "")')">
                                            <i class="bi @(student.HasGrade ? "bi-pencil" : "bi-plus-lg") me-1"></i>
                                            @(student.HasGrade ? "Redaktə" : "Qiymət Ver")
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Qiymət Daxil Etmə / Redaktə Modalı -->
<div class="modal fade" id="gradeModal" tabindex="-1" aria-labelledby="gradeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <form asp-action="SaveGrade" method="post" id="gradeForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="CourseId" value="@Model.CourseId" />
                <input type="hidden" name="EnrollmentId" id="modalEnrollmentId" />
                <input type="hidden" name="StudentName" id="modalStudentNameHidden" />

                <div class="modal-header bg-primary text-white p-3 rounded-top-4">
                    <h5 class="modal-title fw-bold" id="gradeModalLabel">
                        <i class="bi bi-award me-2"></i>Qiymət Daxil Etmə
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Bağla"></button>
                </div>

                <div class="modal-body p-4">
                    <!-- Tələbə Məlumatı -->
                    <div class="alert alert-light border mb-3">
                        <div class="small text-muted">Tələbə:</div>
                        <h6 class="fw-bold mb-0 text-dark" id="modalStudentName"></h6>
                    </div>

                    <!-- Qiymətləndirmə Növləri -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small text-muted">Kollokvium (0-30/50)</label>
                            <input type="number" step="0.5" min="0" max="100" class="form-control score-input" 
                                   name="MidtermScore" id="modalMidterm" placeholder="0" oninput="calculateTotal()" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small text-muted">Tapşırıq (0-20)</label>
                            <input type="number" step="0.5" min="0" max="100" class="form-control score-input" 
                                   name="AssignmentScore" id="modalAssignment" placeholder="0" oninput="calculateTotal()" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small text-muted">İmtahan (0-50/100)</label>
                            <input type="number" step="0.5" min="0" max="100" class="form-control score-input" 
                                   name="FinalScore" id="modalFinal" placeholder="0" oninput="calculateTotal()" />
                        </div>
                    </div>

                    <!-- Yekun Bal və Canlı Hərf/GPA Ön-baxışı -->
                    <div class="card bg-light border-0 rounded-3 p-3 mb-3">
                        <div class="row align-items-center">
                            <div class="col-6">
                                <label class="form-label fw-bold mb-1">Yekun Bal (0 - 100):</label>
                                <input type="number" step="0.5" min="0" max="100" class="form-control form-control-lg fw-bold text-primary" 
                                       name="TotalScore" id="modalTotal" placeholder="0" oninput="updateLetterPreview()" />
                            </div>
                            <div class="col-6 text-center border-start">
                                <div class="small text-muted mb-1">Hərf & GPA Əmsalı:</div>
                                <span class="badge bg-primary fs-5 px-3 py-1" id="previewBadge">F (0.0)</span>
                                <div class="small text-muted mt-1" id="previewStatus">Qeyri-məqbul</div>
                            </div>
                        </div>
                    </div>

                    <!-- Rəy / Qeyd -->
                    <div class="mb-2">
                        <label class="form-label fw-semibold small text-muted">Müəllimin Rəyi / Qeydi (İstəyə bağlı)</label>
                        <textarea class="form-control" name="Feedback" id="modalFeedback" rows="2" 
                                  placeholder="Məsələn: İmtahanda yüksək nəticə göstərdi..."></textarea>
                    </div>
                </div>

                <div class="modal-footer p-3 bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-secondary rounded-3" data-bs-dismiss="modal">İmtina</button>
                    <button type="submit" class="btn btn-success rounded-3 px-4 fw-bold">
                        <i class="bi bi-check2-circle me-1"></i> Qiyməti Yadda Saxla
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openGradeModal(enrollmentId, studentName, midterm, assignment, final, total, feedback) {
            document.getElementById('modalEnrollmentId').value = enrollmentId;
            document.getElementById('modalStudentName').innerText = studentName;
            document.getElementById('modalStudentNameHidden').value = studentName;

            document.getElementById('modalMidterm').value = midterm > 0 ? midterm : '';
            document.getElementById('modalAssignment').value = assignment > 0 ? assignment : '';
            document.getElementById('modalFinal').value = final > 0 ? final : '';
            document.getElementById('modalTotal').value = total > 0 ? total : '';
            document.getElementById('modalFeedback').value = feedback || '';

            updateLetterPreview();

            var modal = new bootstrap.Modal(document.getElementById('gradeModal'));
            modal.show();
        }

        function calculateTotal() {
            var m = parseFloat(document.getElementById('modalMidterm').value) || 0;
            var a = parseFloat(document.getElementById('modalAssignment').value) || 0;
            var f = parseFloat(document.getElementById('modalFinal').value) || 0;

            var sum = m + a + f;
            if (sum > 100) sum = 100;
            document.getElementById('modalTotal').value = sum;
            updateLetterPreview();
        }

        function updateLetterPreview() {
            var total = parseFloat(document.getElementById('modalTotal').value) || 0;
            var badge = document.getElementById('previewBadge');
            var status = document.getElementById('previewStatus');

            if (total >= 91) {
                badge.innerText = 'A (4.0)';
                badge.className = 'badge bg-success fs-5 px-3 py-1';
                status.innerText = 'Məqbul (Əla)';
                status.className = 'small text-success fw-bold mt-1';
            } else if (total >= 81) {
                badge.innerText = 'B (3.0)';
                badge.className = 'badge bg-primary fs-5 px-3 py-1';
                status.innerText = 'Məqbul (Çox yaxşı)';
                status.className = 'small text-primary fw-bold mt-1';
            } else if (total >= 71) {
                badge.innerText = 'C (2.0)';
                badge.className = 'badge bg-info fs-5 px-3 py-1';
                status.innerText = 'Məqbul (Yaxşı)';
                status.className = 'small text-info fw-bold mt-1';
            } else if (total >= 61) {
                badge.innerText = 'D (1.5)';
                badge.className = 'badge bg-warning text-dark fs-5 px-3 py-1';
                status.innerText = 'Məqbul (Kafi)';
                status.className = 'small text-warning fw-bold mt-1';
            } else if (total >= 51) {
                badge.innerText = 'E (1.0)';
                badge.className = 'badge bg-warning text-dark fs-5 px-3 py-1';
                status.innerText = 'Məqbul (Qənaətbəxş)';
                status.className = 'small text-warning fw-bold mt-1';
            } else {
                badge.innerText = 'F (0.0)';
                badge.className = 'badge bg-danger fs-5 px-3 py-1';
                status.innerText = 'Kəsr (Qeyri-məqbul)';
                status.className = 'small text-danger fw-bold mt-1';
            }
        }
    </script>
}
