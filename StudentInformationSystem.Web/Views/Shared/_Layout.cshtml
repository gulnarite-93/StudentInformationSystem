<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SIS (Student Information System)</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <header class="d-print-none">
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm py-2">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-mortarboard-fill fs-3 text-warning me-2"></i>
                    <span>SIS Portal</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Naviqasiyanı aç/bağla">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house me-1"></i> Əsas Səhifə
                            </a>
                        </li>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white fw-semibold" asp-controller="Admin" asp-action="Students">
                                        <i class="bi bi-people-fill me-1"></i> Tələbələr
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white fw-semibold" asp-controller="Admin" asp-action="Courses">
                                        <i class="bi bi-journal-bookmark-fill me-1"></i> Kurslar
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white fw-semibold" asp-controller="Admin" asp-action="Attendance">
                                        <i class="bi bi-calendar-check me-1"></i> Davamiyyət
                                    </a>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-warning" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-gear-fill me-1"></i> Akademik Struktur
                                    </a>
                                    <ul class="dropdown-menu shadow" aria-labelledby="adminDropdown">
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Departments"><i class="bi bi-building me-2"></i>Şöbələr (Departments)</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Programmes"><i class="bi bi-diagram-3 me-2"></i>Proqramlar (Programmes)</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Terms"><i class="bi bi-calendar3 me-2"></i>Akademik Dövrlər (Terms)</a></li>
                                    </ul>
                                </li>
                            }

                            @if (User.IsInRole("Teacher"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white fw-semibold" asp-controller="Teacher" asp-action="Courses">
                                        <i class="bi bi-journal-check me-1"></i> Kurslarım
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white fw-semibold" asp-controller="Teacher" asp-action="Attendance">
                                        <i class="bi bi-calendar-check me-1"></i> Davamiyyət
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-success fw-semibold" asp-controller="Teacher" asp-action="Grades">
                                        <i class="bi bi-award-fill me-1"></i> Qiymətləndirmə
                                    </a>
                                </li>
                            }

                            @if (User.IsInRole("Student"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-info fw-semibold" asp-controller="Student" asp-action="Dashboard">
                                        <i class="bi bi-speedometer2 me-1"></i> Akademik Panel
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Student" asp-action="Profile">
                                        <i class="bi bi-person-badge me-1"></i> Profilim
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Student" asp-action="Enrollment">
                                        <i class="bi bi-pencil-square me-1"></i> Kurs Seçimi
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Student" asp-action="Grades">
                                        <i class="bi bi-award me-1"></i> Qiymətlərim
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Student" asp-action="Attendance">
                                        <i class="bi bi-calendar-check me-1"></i> Davamiyyətim
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-warning" asp-controller="Student" asp-action="Transcript">
                                        <i class="bi bi-file-earmark-spreadsheet me-1"></i> Transkript & GPA
                                    </a>
                                </li>
                            }

                            <!-- Hamı üçün Kurs Kataloqu -->
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Courses" asp-action="Index">
                                    <i class="bi bi-journal-text me-1"></i> Kurs Kataloqu
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-white fw-semibold" asp-controller="Announcements" asp-action="Index">
                                    <i class="bi bi-megaphone me-1 text-warning"></i> Elanlar
                                </a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-center">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
                            var fullName = User.FindFirst("FullName")?.Value ?? User.Identity.Name;

                            <li class="nav-item me-3 text-white d-flex align-items-center">
                                @if (role == "Admin")
                                {
                                    <span class="badge bg-danger me-2"><i class="bi bi-shield-lock-fill me-1"></i>Admin</span>
                                }
                                else if (role == "Teacher")
                                {
                                    <span class="badge bg-success me-2"><i class="bi bi-person-video3 me-1"></i>Müəllim</span>
                                }
                                else if (role == "Student")
                                {
                                    <span class="badge bg-info text-dark me-2"><i class="bi bi-mortarboard me-1"></i>Tələbə</span>
                                }
                                <span class="fw-semibold">@fullName</span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-light btn-sm">
                                        <i class="bi bi-box-arrow-right me-1"></i> Çıxış
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm px-3 fw-semibold" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Daxil Ol
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-4 flex-grow-1">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-white border-top py-3 mt-auto text-muted text-center small d-print-none">
        <div class="container">
            &copy; 2026 - <strong>Student Information System</strong> | Akademik İdarəetmə Portalı
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
