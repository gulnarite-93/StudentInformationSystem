@model StudentInformationSystem.Web.Models.LessonSessionFormViewModel
@{
    ViewData["Title"] = $"{Model.CourseCode} - Sessiya Davamiyyəti";
}

<div class="mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Attendance">Davamiyyət</a></li>
                    <li class="breadcrumb-item"><a asp-action="Attendance" asp-route-courseId="@Model.CourseId">@Model.CourseCode</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Model.LessonDate.ToString("dd.MM.yyyy")</li>
                </ol>
            </nav>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-calendar-check text-primary me-2"></i>Dərs Sessiyasının Davamiyyəti
            </h2>
            <p class="text-muted mb-0">
                <strong>@Model.CourseCode - @Model.CourseName</strong> (@Model.LessonDate.ToString("dd.MM.yyyy")): @Model.LessonTopic
            </p>
        </div>
        <a asp-action="Attendance" asp-route-courseId="@Model.CourseId" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Geri Qayıt
        </a>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-3 overflow-hidden">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <div>
            <strong class="text-dark"><i class="bi bi-journal-text me-1"></i> Dərsin Mövzusu:</strong> @Model.LessonTopic
        </div>
        <div class="small text-muted">
            Tarix: <strong>@Model.LessonDate.ToString("dd.MM.yyyy")</strong>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4" style="width: 50px;">#</th>
                    <th style="width: 140px;">Tələbə Nömrəsi</th>
                    <th>Adı, Soyadı</th>
                    <th style="width: 180px;">Status</th>
                    <th class="pe-4">Qeyd</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Records.Count; i++)
                {
                    var r = Model.Records[i];
                    <tr>
                        <td class="ps-4 fw-bold text-muted">@(i + 1)</td>
                        <td>
                            <span class="badge bg-secondary font-monospace px-2 py-1">
                                @(string.IsNullOrEmpty(r.StudentNumber) ? "Yoxdur" : r.StudentNumber)
                            </span>
                        </td>
                        <td>
                            <strong class="text-dark">@r.StudentName</strong>
                        </td>
                        <td>
                            @if (r.Status == "Present")
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1">
                                    <i class="bi bi-check-circle-fill me-1"></i> Gəldi
                                </span>
                            }
                            else if (r.Status == "Absent")
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1">
                                    <i class="bi bi-x-circle-fill me-1"></i> Qayıb
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-1">
                                    <i class="bi bi-info-circle-fill me-1"></i> İcazəli
                                </span>
                            }
                        </td>
                        <td class="pe-4 text-muted">
                            @(string.IsNullOrEmpty(r.Note) ? "—" : r.Note)
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
