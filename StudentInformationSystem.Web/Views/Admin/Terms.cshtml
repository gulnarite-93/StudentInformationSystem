@model IEnumerable<StudentInformationSystem.Web.Models.TermViewModel>
@{
    ViewData["Title"] = "Akademik Dövrlərin İdarə Edilməsi (Terms)";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1"><i class="bi bi-calendar3 text-primary me-2"></i>Akademik Dövrlər (Terms)</h2>
        <p class="text-muted mb-0">Tədris semestrləri, tarixləri və aktiv dövrün idarəsi (F8).</p>
    </div>
    <a asp-action="CreateTerm" class="btn btn-primary fw-semibold shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> Yeni Semestr Əlavə Et
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Bağla"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Bağla"></button>
    </div>
}

<div class="card shadow-sm border-0 rounded-3">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-calendar-x display-3 text-muted"></i>
                <p class="text-muted mt-3">Hələ heç bir akademik dövr əlavə edilməyib.</p>
                <a asp-action="CreateTerm" class="btn btn-outline-primary btn-sm">İlk Semestri Əlavə Et</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light border-bottom">
                        <tr>
                            <th class="ps-4">DÖVRÜN ADI</th>
                            <th>BAŞLANĞIC TARİXİ</th>
                            <th>BİTMƏ TARİXİ</th>
                            <th class="text-center">STATUS</th>
                            <th class="text-center">KURS SAYI</th>
                            <th class="text-end pe-4">ƏMƏLİYYATLAR</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="fw-bold text-dark">@item.Name</span>
                                </td>
                                <td>
                                    <i class="bi bi-calendar-event text-muted me-1"></i>@item.StartDate.ToString("dd.MM.yyyy")
                                </td>
                                <td>
                                    <i class="bi bi-calendar-check text-muted me-1"></i>@item.EndDate.ToString("dd.MM.yyyy")
                                </td>
                                <td class="text-center">
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill">
                                            <i class="bi bi-check-circle me-1"></i> Aktiv
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-1 rounded-pill">
                                            Qeyri-aktiv
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border rounded-pill">@item.CourseCount kurs</span>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="EditTerm" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1" title="Redaktə et">
                                        <i class="bi bi-pencil"></i> Redaktə
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteTermModal-@item.Id" title="Sil">
                                        <i class="bi bi-trash"></i> Sil
                                    </button>

                                    <!-- Delete Modal -->
                                    <div class="modal fade" id="deleteTermModal-@item.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered text-start">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Akademik Dövrü Sil</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Bağla"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <p class="mb-0">
                                                        <strong>@item.Name</strong> akademik dövrünü silmək istədiyinizdən əminsiniz?
                                                    </p>
                                                    <small class="text-muted">Əgər bu dövrə təhkim olunmuş fənlər/kurslar varsa, silinməyə icazə verilməyəcək.</small>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Ləğv et</button>
                                                    <form asp-action="DeleteTerm" asp-route-id="@item.Id" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-danger btn-sm">Təsdiq et və Sil</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
