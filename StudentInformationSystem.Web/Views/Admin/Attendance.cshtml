@model StudentInformationSystem.Web.Models.TeacherCourseAttendanceOverviewViewModel
@{
    ViewData["Title"] = "Davamiyyət İdarəsi (Admin)";
    var courses = ViewBag.Courses as List<StudentInformationSystem.Web.Models.CourseViewModel> ?? new();
    int selectedCourseId = ViewBag.SelectedCourseId != null ? (int)ViewBag.SelectedCourseId : 0;
}

<div class="mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-calendar-check text-primary me-2"></i>Bütün Kurslar üzrə Davamiyyət (F5)
            </h2>
            <p class="text-muted mb-0">
                Sistem üzrə tədris edilən fənlərin və müəllimlərin daxil etdiyi davamiyyət qeydlərinin monitorinqi.
            </p>
        </div>
        <a asp-action="Courses" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-journal-text me-1"></i> Kurslar Kataloqu
        </a>
    </div>
</div>

<!-- Fənn Seçim Kartı -->
<div class="card shadow-sm border-0 rounded-3 mb-4">
    <div class="card-body p-3">
        <form asp-action="Attendance" method="get" class="row g-3 align-items-center">
            <div class="col-md-6">
                <label class="form-label fw-semibold small mb-1">Baxmaq istədiyiniz kursu seçin:</label>
                <select name="courseId" class="form-select" onchange="this.form.submit()">
                    <option value="">-- Kurs seçin --</option>
                    @foreach (var c in courses)
                    {
                        if (c.Id == selectedCourseId)
                        {
                            <option value="@c.Id" selected>@c.Code - @c.Name (@c.TermName, @(c.TeacherName ?? "Müəllimsiz"))</option>
                        }
                        else
                        {
                            <option value="@c.Id">@c.Code - @c.Name (@c.TermName, @(c.TeacherName ?? "Müəllimsiz"))</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-6 text-md-end mt-md-4">
                @if (selectedCourseId > 0 && Model.Course.Id > 0)
                {
                    <a asp-action="CourseStudents" asp-route-courseId="@Model.Course.Id" class="btn btn-outline-info btn-sm">
                        <i class="bi bi-people me-1"></i> Kursun Tələbələri (@Model.Course.EnrolledStudentsCount)
                    </a>
                }
            </div>
        </form>
    </div>
</div>

@if (selectedCourseId <= 0 || Model.Course.Id <= 0)
{
    <div class="card shadow-sm border-0 rounded-4 text-center py-5">
        <div class="card-body">
            <i class="bi bi-calendar-event display-4 text-muted"></i>
            <h5 class="mt-3 text-dark fw-bold">Davamiyyətə baxmaq üçün yuxarıdan bir kurs seçin</h5>
            <p class="text-muted small">Kurs seçildikdən sonra həmin fənnin bütün dərs sessiyaları burada əks olunacaq.</p>
        </div>
    </div>
}
else
{
    <!-- Kurs Detalları -->
    <div class="card shadow-sm border-0 rounded-3 mb-4 bg-light border-start border-primary border-4">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center">
                <div class="col-md-3">
                    <span class="text-muted small d-block">Kurs:</span>
                    <span class="badge bg-secondary font-monospace">@Model.Course.Code</span>
                    <strong class="text-dark ms-1">@Model.Course.Name</strong>
                </div>
                <div class="col-md-3">
                    <span class="text-muted small d-block">Müəllim:</span>
                    <strong class="text-dark">@(Model.Course.TeacherName ?? "Təyin olunmayıb")</strong>
                </div>
                <div class="col-md-3">
                    <span class="text-muted small d-block">Semestr:</span>
                    <strong class="text-dark">@Model.Course.TermName</strong>
                </div>
                <div class="col-md-3 text-md-end">
                    <span class="text-muted small d-block">Keçirilmiş Dərslər:</span>
                    <span class="badge bg-primary fs-6 px-3 py-1">@Model.Sessions.Count sessiya</span>
                </div>
            </div>
        </div>
    </div>

    @if (!Model.Sessions.Any())
    {
        <div class="card shadow-sm border-0 rounded-4 text-center py-5">
            <div class="card-body">
                <i class="bi bi-calendar-x display-4 text-muted"></i>
                <h5 class="mt-3 text-dark fw-bold">Bu kurs üzrə hələ heç bir dərs sessiyası qeydə alınmayıb</h5>
                <p class="text-muted small">Fənnin müəllimi dərs sessiyası yaratdıqda qeydlər avtomatik burada əks olunacaq.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Tarix</th>
                            <th>Mövzu</th>
                            <th>Cəmi Tələbə</th>
                            <th>Gəldi (İştirak)</th>
                            <th>Qayıb</th>
                            <th>İcazəli</th>
                            <th class="text-end pe-4">Təfərrüat</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.Sessions)
                        {
                            <tr>
                                <td class="ps-4">
                                    <strong class="text-dark"><i class="bi bi-calendar-event text-primary me-2"></i>@s.LessonDate.ToString("dd.MM.yyyy")</strong>
                                </td>
                                <td>
                                    <span class="fw-semibold text-secondary">@s.LessonTopic</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@s.TotalStudents</span>
                                </td>
                                <td>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                        <i class="bi bi-check-circle me-1"></i>@s.PresentCount
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                        <i class="bi bi-x-circle me-1"></i>@s.AbsentCount
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1">
                                        <i class="bi bi-info-circle me-1"></i>@s.ExcusedCount
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="AttendanceSessionDetails" asp-route-courseId="@s.CourseId" 
                                       asp-route-date="@s.LessonDate.ToString("yyyy-MM-dd")" class="btn btn-outline-primary btn-sm">
                                        <i class="bi bi-eye me-1"></i> Baxış
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}
