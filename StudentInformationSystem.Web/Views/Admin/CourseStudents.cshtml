@model StudentInformationSystem.Web.Models.CourseStudentsViewModel
@{
    ViewData["Title"] = $"{Model.Course.Code} - Tələbələrin Siyahısı";
}

<div class="mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Courses">Kurslar</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Model.Course.Code</li>
                </ol>
            </nav>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-people-fill text-primary me-2"></i>Kursa Yazılmış Tələbələr
            </h2>
            <p class="text-muted mb-0">
                <strong>@Model.Course.Code - @Model.Course.Name</strong> fənni üzrə qeydiyyatdan keçmiş tələbələrin idarə olunması.
            </p>
        </div>
        <a asp-action="Courses" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Kurslar Siyahısına Qayıt
        </a>
    </div>
</div>

<!-- Kurs Məlumat Kartı -->
<div class="card shadow-sm border-0 rounded-3 mb-4 bg-light">
    <div class="card-body p-3">
        <div class="row g-3 align-items-center">
            <div class="col-md-3">
                <span class="text-muted small d-block">Kurs:</span>
                <span class="badge bg-secondary font-monospace">@Model.Course.Code</span>
                <strong class="text-dark ms-1">@Model.Course.Name</strong>
            </div>
            <div class="col-md-3">
                <span class="text-muted small d-block">Müəllim:</span>
                <strong class="text-dark">@(Model.Course.TeacherName != null ? $"{Model.Course.TeacherTitle ?? ""} {Model.Course.TeacherName}" : "Təyin olunmayıb")</strong>
            </div>
            <div class="col-md-3">
                <span class="text-muted small d-block">Semestr / İxtisas:</span>
                <strong class="text-dark">@Model.Course.TermName</strong>
                <div class="small text-muted">@Model.Course.ProgrammeName</div>
            </div>
            <div class="col-md-3 text-md-end">
                <span class="text-muted small d-block">Qeydiyyat Sayı:</span>
                <span class="badge bg-primary fs-6 px-3 py-1">@Model.Students.Count tələbə</span>
            </div>
        </div>
    </div>
</div>

@if (!Model.Students.Any())
{
    <div class="card shadow-sm border-0 rounded-4 text-center py-5">
        <div class="card-body">
            <i class="bi bi-person-x display-3 text-muted"></i>
            <h4 class="mt-3 text-dark fw-bold">Bu kursa hələ heç bir tələbə qeydiyyatdan keçməyib</h4>
            <p class="text-muted col-md-6 mx-auto">
                Tələbələr "Kursa Qeydiyyat" bölməsindən və ya admin "Tələbələr" menyusundan bu kursa yazıla bilər.
            </p>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4" style="width: 50px;">#</th>
                        <th>Tələbə Nömrəsi</th>
                        <th>Adı, Soyadı</th>
                        <th>E-poçt / Əlaqə</th>
                        <th>İxtisas / Kurs</th>
                        <th>Qeydiyyat Tarixi</th>
                        <th class="text-end pe-4">Əməliyyat</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int index = 1; }
                    @foreach (var s in Model.Students)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-muted">@(index++)</td>
                            <td>
                                <span class="badge bg-dark-subtle text-dark font-monospace px-2 py-1">
                                    @(string.IsNullOrEmpty(s.StudentNumber) ? "Yoxdur" : s.StudentNumber)
                                </span>
                            </td>
                            <td>
                                <strong class="text-dark">@s.FullName</strong>
                            </td>
                            <td>
                                <div><i class="bi bi-envelope text-muted me-1"></i>@s.Email</div>
                                @if (!string.IsNullOrEmpty(s.PhoneNumber))
                                {
                                    <div class="small text-muted"><i class="bi bi-telephone text-muted me-1"></i>@s.PhoneNumber</div>
                                }
                            </td>
                            <td>
                                <div>@s.ProgrammeName</div>
                                @if (s.AcademicYear.HasValue)
                                {
                                    <small class="text-muted">@s.AcademicYear-ci kurs</small>
                                }
                            </td>
                            <td class="small text-muted">
                                @s.EnrollmentDate.ToString("dd.MM.yyyy HH:mm")
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="StudentEnrollments" asp-route-studentId="@s.StudentId" class="btn btn-outline-info btn-sm">
                                    <i class="bi bi-journal-bookmark me-1"></i> Qeydiyyatlar
                                </a>
                                <form asp-action="AdminDropStudent" method="post" class="d-inline"
                                      onsubmit="return confirm('@s.FullName tələbəsini bu kursdan çıxarmaq istədiyinizdən əminsiniz?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="enrollmentId" value="@s.EnrollmentId" />
                                    <input type="hidden" name="studentId" value="@s.StudentId" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm" title="Kursdan Çıxar">
                                        <i class="bi bi-x-circle"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
