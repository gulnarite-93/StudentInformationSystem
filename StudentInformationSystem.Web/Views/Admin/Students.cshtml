@model IEnumerable<StudentInformationSystem.Web.Models.StudentViewModel>
@{
    ViewData["Title"] = "Tələbələrin İdarə Edilməsi (F1)";
    var programmes = ViewBag.Programmes as List<StudentInformationSystem.Web.Models.ProgrammeViewModel> ?? new();
    string? currentSearch = ViewBag.CurrentSearch as string;
    int? currentProgrammeId = ViewBag.CurrentProgrammeId as int?;
    int? currentAcademicYear = ViewBag.CurrentAcademicYear as int?;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1"><i class="bi bi-people-fill text-primary me-2"></i>Tələbələrin İdarə Edilməsi (F1)</h2>
        <p class="text-muted mb-0">Tələbə profilləri, qeydiyyat, axtarış və məlumatların tənzimlənməsi.</p>
    </div>
    <a asp-action="CreateStudent" class="btn btn-primary fw-semibold shadow-sm">
        <i class="bi bi-person-plus-fill me-1"></i> Yeni Tələbə Əlavə Et
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Bağla"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Bağla"></button>
    </div>
}

<!-- Axtarış və Filtrlər -->
<div class="card shadow-sm border-0 mb-4 rounded-3">
    <div class="card-body p-3">
        <form asp-action="Students" method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" value="@currentSearch" class="form-control" placeholder="Ad, soyad, tələbə nömrəsi, e-poçt ilə axtar..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="programmeId" class="form-select">
                    <option value="">-- Bütün İxtisaslar --</option>
                    @foreach (var p in programmes)
                    {
                        <option value="@p.Id" selected="@(currentProgrammeId == p.Id)">@p.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="academicYear" class="form-select">
                    <option value="">-- Bütün Kurslar --</option>
                    <option value="1" selected="@(currentAcademicYear == 1)">1-ci kurs</option>
                    <option value="2" selected="@(currentAcademicYear == 2)">2-ci kurs</option>
                    <option value="3" selected="@(currentAcademicYear == 3)">3-cü kurs</option>
                    <option value="4" selected="@(currentAcademicYear == 4)">4-cü kurs</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100 fw-semibold">
                    <i class="bi bi-funnel me-1"></i> Filtrlə
                </button>
                @if (!string.IsNullOrEmpty(currentSearch) || currentProgrammeId.HasValue || currentAcademicYear.HasValue)
                {
                    <a asp-action="Students" class="btn btn-outline-secondary" title="Sıfırla">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Tələbələr Cədvəli -->
<div class="card shadow-sm border-0 rounded-3">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-person-x display-3 text-muted"></i>
                <p class="text-muted mt-3">Axtarışa uyğun heç bir tələbə tapılmadı.</p>
                <a asp-action="Students" class="btn btn-outline-primary btn-sm">Bütün Tələbələrə Bax</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light border-bottom">
                        <tr>
                            <th class="ps-4">ST ID</th>
                            <th>TƏLƏBƏ</th>
                            <th>İXTİSAS & ŞÖBƏ</th>
                            <th class="text-center">KURS</th>
                            <th>ƏLAQƏ</th>
                            <th class="text-end pe-4">ƏMƏLİYYATLAR</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="badge bg-secondary font-monospace px-2 py-1">@(s.StudentNumber ?? "—")</span>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@s.FullName</div>
                                    <small class="text-muted">@@@s.Username</small>
                                </td>
                                <td>
                                    <div class="text-dark fw-semibold">@(s.ProgrammeName ?? "Təyin olunmayıb")</div>
                                    <small class="text-muted">@(s.DepartmentName ?? "")</small>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill px-3 py-1">
                                        @(s.AcademicYear.HasValue ? $"{s.AcademicYear}-ci kurs" : "—")
                                    </span>
                                </td>
                                <td>
                                    <div class="small"><i class="bi bi-envelope text-muted me-1"></i>@s.Email</div>
                                    @if (!string.IsNullOrEmpty(s.PhoneNumber))
                                    {
                                        <div class="small text-muted"><i class="bi bi-telephone text-muted me-1"></i>@s.PhoneNumber</div>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="EditStudent" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary me-1" title="Redaktə et">
                                        <i class="bi bi-pencil"></i> Redaktə
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteStudentModal-@s.Id" title="Sil">
                                        <i class="bi bi-trash"></i> Sil
                                    </button>

                                    <!-- Delete Modal -->
                                    <div class="modal fade" id="deleteStudentModal-@s.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered text-start">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Tələbəni Sil</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Bağla"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <p class="mb-0">
                                                        <strong>@s.FullName (@s.StudentNumber)</strong> adlı tələbəni sistemdən silmək istədiyinizdən əminsiniz?
                                                    </p>
                                                    <small class="text-muted">Əgər tələbənin kurs qeydiyyatları və ya davamiyyət jurnalı varsa, sistem silinməyə icazə verməyəcək.</small>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Ləğv et</button>
                                                    <form asp-action="DeleteStudent" asp-route-id="@s.Id" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-danger btn-sm">Təsdiq et və Sil</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
