@model StudentInformationSystem.Web.Models.TermFormModel
@{
    ViewData["Title"] = "Yeni Akademik Dövr Əlavə Et";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-white py-3 border-bottom">
                <h4 class="mb-0 fw-bold text-primary"><i class="bi bi-plus-circle me-2"></i>Yeni Akademik Dövr Əlavə Et</h4>
                <small class="text-muted">Tədris semestri və aktivlik statusunu təyin edin.</small>
            </div>
            <div class="card-body p-4">
                <form asp-action="CreateTerm" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" placeholder="Məs: 2026-2027 Payız Semestri" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="StartDate" class="form-label fw-semibold"></label>
                            <input asp-for="StartDate" class="form-control" />
                            <span asp-validation-for="StartDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EndDate" class="form-label fw-semibold"></label>
                            <input asp-for="EndDate" class="form-control" />
                            <span asp-validation-for="EndDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4 form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="isActiveSwitch" />
                        <label class="form-check-label fw-semibold" for="isActiveSwitch">Bu dövr aktiv semestr olsun</label>
                        <small class="text-muted d-block">Aktiv semestr tələbələrin cari kurs qeydiyyatı və davamiyyəti üçün istifadə olunur.</small>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Terms" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Geri Qayıt
                        </a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">
                            <i class="bi bi-check-circle me-1"></i> Yadda Saxla
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
