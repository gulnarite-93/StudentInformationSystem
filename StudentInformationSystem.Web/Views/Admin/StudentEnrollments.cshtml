@model StudentInformationSystem.Web.Models.AdminStudentEnrollmentsViewModel
@{
    ViewData["Title"] = $"{Model.Student.FullName} - Kurs Qeydiyyatları";
}

<div class="mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Students">Tələbələrin İdarəsi</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Model.Student.FullName</li>
                </ol>
            </nav>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-journal-bookmark text-primary me-2"></i>Tələbənin Kurs Qeydiyyatları (F3)
            </h2>
            <p class="text-muted mb-0">
                Admin tərəfindən tələbənin fənn qeydiyyatlarının yoxlanılması, yeni kursa yazılması və ya çıxarılması.
            </p>
        </div>
        <a asp-action="Students" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Tələbələr Siyahısına Qayıt
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Bağla"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Bağla"></button>
    </div>
}

<!-- Tələbə haqqında Məlumat Kartı -->
<div class="card shadow-sm border-0 rounded-3 mb-4 bg-light border-start border-primary border-4">
    <div class="card-body p-3">
        <div class="row g-3 align-items-center">
            <div class="col-md-3">
                <span class="text-muted small d-block">Tələbə Nömrəsi:</span>
                <span class="badge bg-secondary font-monospace px-2 py-1 fs-6">
                    @(string.IsNullOrEmpty(Model.Student.StudentNumber) ? "Yoxdur" : Model.Student.StudentNumber)
                </span>
            </div>
            <div class="col-md-3">
                <span class="text-muted small d-block">Ad, Soyad:</span>
                <strong class="text-dark fs-5">@Model.Student.FullName</strong>
                <div class="small text-muted">@Model.Student.Email</div>
            </div>
            <div class="col-md-3">
                <span class="text-muted small d-block">İxtisas / Tədris İli:</span>
                <strong class="text-dark">@Model.Student.ProgrammeName</strong>
                @if (Model.Student.AcademicYear.HasValue)
                {
                    <span class="text-muted small d-block">@Model.Student.AcademicYear-ci kurs</span>
                }
            </div>
            <div class="col-md-3 text-md-end">
                <span class="text-muted small d-block">Toplam Aktiv Kredit:</span>
                <span class="badge bg-primary fs-6 px-3 py-1">@Model.TotalEnrolledCredits Kredit</span>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- SOL: Yazıldığı Kurslar Siyahısı -->
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 rounded-3 h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-journal-check text-success me-2"></i>Yazıldığı Kurslar
                </h5>
                <span class="badge bg-success rounded-pill px-3 py-1">
                    @Model.Enrollments.Count(e => e.Status == "Enrolled") fənn
                </span>
            </div>
            <div class="card-body p-0">
                @if (!Model.Enrollments.Any(e => e.Status == "Enrolled"))
                {
                    <div class="text-center py-5">
                        <i class="bi bi-journal-x display-4 text-muted"></i>
                        <h6 class="mt-3 text-dark fw-bold">Tələbə hələ heç bir kursa yazılmayıb</h6>
                        <p class="text-muted small">Sağ tərəfdəki form vasitəsilə tələbəni birbaşa kursa yaza bilərsiniz.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Kod</th>
                                    <th>Kurs</th>
                                    <th>Kredit</th>
                                    <th>Müəllim</th>
                                    <th>Semestr</th>
                                    <th class="text-end pe-3">Əməliyyat</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var enr in Model.Enrollments.Where(e => e.Status == "Enrolled"))
                                {
                                    <tr>
                                        <td class="ps-3">
                                            <span class="badge bg-secondary font-monospace px-2 py-1">@enr.CourseCode</span>
                                        </td>
                                        <td>
                                            <strong class="text-dark">@enr.CourseName</strong>
                                            <div class="small text-muted">@enr.ProgrammeName</div>
                                        </td>
                                        <td>
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                                @enr.Credits Krd
                                            </span>
                                        </td>
                                        <td class="small">
                                            @(enr.TeacherName != null ? $"{enr.TeacherTitle ?? ""} {enr.TeacherName}" : "Təyin edilməyib")
                                        </td>
                                        <td>
                                            <span class="badge @(enr.IsTermActive ? "bg-success-subtle text-success" : "bg-light text-muted border")">
                                                @enr.TermName
                                            </span>
                                        </td>
                                        <td class="text-end pe-3">
                                            <form asp-action="AdminDropStudent" method="post" class="d-inline"
                                                  onsubmit="return confirm('Tələbəni bu kursdan çıxarmaq istədiyinizdən əminsiniz?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="enrollmentId" value="@enr.Id" />
                                                <input type="hidden" name="studentId" value="@Model.Student.Id" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm" title="Qeydiyyatı Ləğv Et">
                                                    <i class="bi bi-person-dash me-1"></i> Çıxar
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- SAĞ: Yeni Kursa Yazma Formu -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 rounded-3 border-top border-primary border-4 h-100">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-person-plus text-primary me-2"></i>Kursa Əlavə Et
                </h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="AdminEnrollStudent" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="studentId" value="@Model.Student.Id" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Kurs Seçin:</label>
                        <select name="courseId" class="form-select" required>
                            <option value="">-- Kurs seçin --</option>
                            @foreach (var c in Model.AvailableCourses)
                            {
                                bool already = Model.Enrollments.Any(e => e.CourseId == c.Id && e.Status == "Enrolled");
                                if (already)
                                {
                                    <option value="@c.Id" disabled>@c.Code - @c.Name (@c.Credits Krd) [Artıq yazılıb]</option>
                                }
                                else
                                {
                                    <option value="@c.Id">@c.Code - @c.Name (@c.Credits Krd, @c.TermName)</option>
                                }
                            }
                        </select>
                        <div class="form-text">
                            Admin hüququ ilə tələbə istənilən semestr və ixtisas kursuna yazıla bilər.
                        </div>
                    </div>

                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-primary fw-semibold">
                            <i class="bi bi-plus-circle me-1"></i> Tələbəni Bu Kursa Yaz
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
