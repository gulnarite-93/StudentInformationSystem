@model StudentInformationSystem.Web.Models.DepartmentFormModel
@{
    ViewData["Title"] = "Yeni Şöbə Əlavə Et";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-white py-3 border-bottom">
                <h4 class="mb-0 fw-bold text-primary"><i class="bi bi-plus-circle me-2"></i>Yeni Şöbə Əlavə Et</h4>
                <small class="text-muted">Fakültə və ya akademik şöbə məlumatlarını daxil edin.</small>
            </div>
            <div class="card-body p-4">
                <form asp-action="CreateDepartment" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" placeholder="Məs: Kompüter Elmləri və Mühəndislik" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Code" class="form-label fw-semibold"></label>
                        <input asp-for="Code" class="form-control text-uppercase" placeholder="Məs: CS" style="max-width: 200px;" />
                        <small class="text-muted d-block mt-1">Şöbə üçün qısa unikal kod (məsələn: CS, ECON, IT).</small>
                        <span asp-validation-for="Code" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Şöbə haqqında qısa təsvir (istəyə görə)..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Departments" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Geri Qayıt
                        </a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">
                            <i class="bi bi-check-circle me-1"></i> Yadda Saxla
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
