@model StudentInformationSystem.Web.Models.StudentCourseRegistrationPageViewModel
@{
    ViewData["Title"] = "Kursa Qeydiyyat (F3)";
}

<div class="mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-pencil-square text-primary me-2"></i>Kursa Qeydiyyat və Fənn Seçimi (F3)
            </h2>
            <p class="text-muted mb-0">
                Cari akademik semestr üzrə fənlərin seçimi və aktiv qeydiyyatlarınızın idarə edilməsi.
            </p>
        </div>
        <a asp-controller="Courses" asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-journal-text me-1"></i> Ümumi Kurs Kataloqu
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Bağla"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Bağla"></button>
    </div>
}

<!-- Statistik Xülasə Kartları -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm border-0 rounded-3 border-start border-primary border-4">
            <div class="card-body p-3 d-flex align-items-center">
                <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3 text-primary">
                    <i class="bi bi-calendar-event fs-3"></i>
                </div>
                <div>
                    <span class="text-muted small d-block">Cari Akademik Semestr</span>
                    <strong class="text-dark fs-5">@Model.ActiveTermName</strong>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 rounded-3 border-start border-success border-4">
            <div class="card-body p-3 d-flex align-items-center">
                <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3 text-success">
                    <i class="bi bi-journal-check fs-3"></i>
                </div>
                <div>
                    <span class="text-muted small d-block">Yazıldığım Kurs Sayı</span>
                    <strong class="text-dark fs-4">@Model.TotalEnrolledCount fənn</strong>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 rounded-3 border-start border-info border-4">
            <div class="card-body p-3 d-flex align-items-center">
                <div class="rounded-circle bg-info bg-opacity-10 p-3 me-3 text-info">
                    <i class="bi bi-award fs-3"></i>
                </div>
                <div>
                    <span class="text-muted small d-block">Cəmi Toplanan Kredit</span>
                    <strong class="text-dark fs-4">@Model.TotalEnrolledCredits Kredit</strong>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Naviqasiya Tabları -->
<ul class="nav nav-pills mb-4" id="enrollmentTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active px-4 py-2 fw-semibold" id="my-courses-tab" data-bs-toggle="tab" data-bs-target="#my-courses" type="button" role="tab" aria-selected="true">
            <i class="bi bi-journal-check me-2"></i>Yazıldığım Kurslar
            <span class="badge bg-primary rounded-pill ms-2">@Model.TotalEnrolledCount</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link px-4 py-2 fw-semibold" id="available-courses-tab" data-bs-toggle="tab" data-bs-target="#available-courses" type="button" role="tab" aria-selected="false">
            <i class="bi bi-plus-circle me-2"></i>Kursa Yazıl (Fənn Seçimi)
            <span class="badge bg-secondary rounded-pill ms-2">@Model.AvailableCourses.Count</span>
        </button>
    </li>
</ul>

<div class="tab-content" id="enrollmentTabsContent">
    <!-- TAB 1: Yazıldığım Kurslar -->
    <div class="tab-pane fade show active" id="my-courses" role="tabpanel" aria-labelledby="my-courses-tab">
        @if (!Model.MyEnrollments.Any(e => e.Status == "Enrolled"))
        {
            <div class="card shadow-sm border-0 rounded-4 text-center py-5">
                <div class="card-body">
                    <i class="bi bi-journal-x display-3 text-muted"></i>
                    <h4 class="mt-3 text-dark fw-bold">Siz hələ heç bir fənnə yazılmamısınız</h4>
                    <p class="text-muted col-md-6 mx-auto">
                        Cari aktiv semestr üçün tədris olunan fənləri seçmək üçün yuxarıdakı "Kursa Yazıl (Fənn Seçimi)" bölməsinə keçin.
                    </p>
                    <button class="btn btn-primary btn-sm mt-2" onclick="document.getElementById('available-courses-tab').click();">
                        <i class="bi bi-arrow-right me-1"></i> Fənn Seçiminə Keç
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Kod</th>
                                <th>Kursun Adı</th>
                                <th>Kredit</th>
                                <th>Müəllim</th>
                                <th>Semestr</th>
                                <th>Qeydiyyat Tarixi</th>
                                <th class="text-end pe-4">Əməliyyat</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var enr in Model.MyEnrollments.Where(e => e.Status == "Enrolled"))
                            {
                                <tr>
                                    <td class="ps-4">
                                        <span class="badge bg-secondary font-monospace px-2 py-1">@enr.CourseCode</span>
                                    </td>
                                    <td>
                                        <strong class="text-dark">@enr.CourseName</strong>
                                        <div class="small text-muted">@enr.ProgrammeName</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                            @enr.Credits Kredit
                                        </span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(enr.TeacherName))
                                        {
                                            <div><i class="bi bi-person-circle text-muted me-1"></i>@(enr.TeacherTitle ?? "") @enr.TeacherName</div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Təyin olunmayıb</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge @(enr.IsTermActive ? "bg-success-subtle text-success border border-success-subtle" : "bg-light text-muted border")">
                                            @enr.TermName
                                        </span>
                                    </td>
                                    <td class="small text-muted">
                                        @enr.EnrollmentDate.ToString("dd.MM.yyyy HH:mm")
                                    </td>
                                    <td class="text-end pe-4">
                                        @if (enr.IsTermActive)
                                        {
                                            <form asp-controller="Student" asp-action="Drop" method="post" class="d-inline"
                                                  onsubmit="return confirm('Bu fəndən imtina etmək istədiyinizdən əminsiniz?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="enrollmentId" value="@enr.Id" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                                    <i class="bi bi-box-arrow-right me-1"></i> Kursdan Çıx (Drop)
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Dövr bağlanıb</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    <!-- TAB 2: Mövcud Kurslar (Fənn Seçimi) -->
    <div class="tab-pane fade" id="available-courses" role="tabpanel" aria-labelledby="available-courses-tab">
        <div class="row g-4">
            @if (!Model.AvailableCourses.Any())
            {
                <div class="col-12">
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle me-2"></i>Hazırda qeydiyyat üçün aktiv akademik dövrə aid kurs mövcud deyil.
                    </div>
                </div>
            }
            else
            {
                @foreach (var c in Model.AvailableCourses)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm border-0 rounded-3 @(c.IsAlreadyEnrolled ? "border-top border-success border-4" : "border-top border-primary border-4")">
                            <div class="card-body d-flex flex-column p-4">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <span class="badge bg-secondary font-monospace px-2 py-1">@c.Code</span>
                                    <span class="badge bg-primary rounded-pill px-3 py-1">@c.Credits KREDİT</span>
                                </div>

                                <h5 class="card-title fw-bold text-dark mb-2">@c.Name</h5>

                                <p class="card-text text-muted small flex-grow-1">
                                    @(string.IsNullOrEmpty(c.Description) ? "Kurs üzrə təsvir qeyd edilməyib." : c.Description)
                                </p>

                                <hr class="my-3" />

                                <div class="small mb-2">
                                    <span class="text-muted"><i class="bi bi-diagram-3 me-1"></i>İxtisas:</span>
                                    <strong class="text-dark">@c.ProgrammeName</strong>
                                </div>

                                <div class="small mb-2">
                                    <span class="text-muted"><i class="bi bi-person-circle me-1"></i>Müəllim:</span>
                                    <strong class="text-dark">@(c.TeacherName != null ? $"{c.TeacherTitle ?? ""} {c.TeacherName}" : "Təyin olunmayıb")</strong>
                                </div>

                                <div class="small mb-3">
                                    <span class="text-muted"><i class="bi bi-people-fill me-1"></i>Qeydiyyatdan keçən:</span>
                                    <span class="badge bg-light text-dark border ms-1">@c.EnrolledStudentsCount tələbə</span>
                                </div>

                                <div class="mt-auto pt-2">
                                    @if (c.IsAlreadyEnrolled)
                                    {
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fw-semibold">
                                                <i class="bi bi-check-circle-fill me-1"></i> Artıq Yazılmısınız
                                            </span>
                                            <form asp-controller="Student" asp-action="Drop" method="post" class="d-inline"
                                                  onsubmit="return confirm('Bu fəndən imtina etmək istədiyinizdən əminsiniz?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="enrollmentId" value="@c.EnrollmentId" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                                    <i class="bi bi-x-circle me-1"></i> Çıx
                                                </button>
                                            </form>
                                        </div>
                                    }
                                    else
                                    {
                                        <form asp-controller="Student" asp-action="Enroll" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="courseId" value="@c.CourseId" />
                                            <button type="submit" class="btn btn-success w-100 fw-semibold">
                                                <i class="bi bi-plus-circle me-1"></i> Bu Kursa Yazıl
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>
