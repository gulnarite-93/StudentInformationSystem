@model StudentInformationSystem.Web.Models.StudentDashboardViewModel
@{
    ViewData["Title"] = "Akademik Panel (Dashboard)";
}

<div class="container-fluid py-3">
    <!-- Xoş Gəlmisiniz Başlığı -->
    <div class="card border-0 rounded-4 shadow-sm bg-gradient text-white mb-4" 
         style="background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);">
        <div class="card-body p-4">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <span class="badge bg-white text-primary mb-2 px-3 py-1 fw-bold">Tələbə Portalı (F6)</span>
                    <h2 class="fw-bold mb-1">Xoş gəldiniz, @Model.FullName!</h2>
                    <p class="mb-0 text-white-50">
                        <span class="me-3"><i class="bi bi-person-vcard me-1"></i>Tələbə №: <strong>@(string.IsNullOrEmpty(Model.StudentNumber) ? "Yoxdur" : Model.StudentNumber)</strong></span>
                        <span class="me-3"><i class="bi bi-diagram-3 me-1"></i>İxtisas: <strong>@Model.ProgrammeName</strong></span>
                        @if (Model.AcademicYear.HasValue)
                        {
                            <span><i class="bi bi-mortarboard me-1"></i>Kurs: <strong>@Model.AcademicYear-ci kurs</strong></span>
                        }
                    </p>
                </div>
                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    <a asp-action="Transcript" class="btn btn-light text-primary fw-bold rounded-pill px-4 shadow-sm me-2">
                        <i class="bi bi-file-earmark-spreadsheet me-1"></i> Transkript
                    </a>
                    <a asp-action="Grades" class="btn btn-outline-light rounded-pill px-3">
                        <i class="bi bi-award me-1"></i> Qiymətlər
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- 4 Əsas Statistik Kart (F6 Tələbləri) -->
    <div class="row g-3 mb-4">
        <!-- 1. Cari GPA -->
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0 rounded-4 p-3 bg-white h-100 card-stat">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <span class="text-muted text-uppercase fw-bold small">Cari GPA</span>
                        <h2 class="fw-bold text-primary mb-0 mt-1">@Model.CurrentGpa.ToString("0.00")</h2>
                    </div>
                    <div class="rounded-circle bg-primary-subtle text-primary p-3">
                        <i class="bi bi-stars fs-4"></i>
                    </div>
                </div>
                <div class="mt-auto">
                    <div class="d-flex justify-content-between small text-muted mb-1">
                        <span>Şkala: 4.00</span>
                        <span class="fw-bold @(Model.CurrentGpa >= 3.0m ? "text-success" : Model.CurrentGpa >= 2.0m ? "text-primary" : "text-danger")">
                            @(Model.CurrentGpa >= 3.5m ? "Əla" : Model.CurrentGpa >= 3.0m ? "Çox yaxşı" : Model.CurrentGpa >= 2.0m ? "Yaxşı" : Model.CurrentGpa >= 1.0m ? "Kafi" : "Qeyri-məqbul")
                        </span>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar bg-primary" role="progressbar" 
                             style="width: @(Math.Min(Model.CurrentGpa / 4.0m * 100, 100))%;"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Ümumi Kredit -->
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0 rounded-4 p-3 bg-white h-100 card-stat">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <span class="text-muted text-uppercase fw-bold small">Ümumi Kredit</span>
                        <h2 class="fw-bold text-success mb-0 mt-1">@Model.TotalCredits</h2>
                    </div>
                    <div class="rounded-circle bg-success-subtle text-success p-3">
                        <i class="bi bi-mortarboard-fill fs-4"></i>
                    </div>
                </div>
                <div class="mt-auto">
                    <small class="text-muted">
                        <i class="bi bi-check-circle-fill text-success me-1"></i>Akademik kreditlərin ümumi cəmi
                    </small>
                </div>
            </div>
        </div>

        <!-- 3. Kurs Sayı -->
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0 rounded-4 p-3 bg-white h-100 card-stat">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <span class="text-muted text-uppercase fw-bold small">Yazılmış Kurslar</span>
                        <h2 class="fw-bold text-info mb-0 mt-1">@Model.EnrolledCoursesCount</h2>
                    </div>
                    <div class="rounded-circle bg-info-subtle text-info p-3">
                        <i class="bi bi-journal-bookmark-fill fs-4"></i>
                    </div>
                </div>
                <div class="mt-auto">
                    <small class="text-muted">
                        <i class="bi bi-book me-1 text-info"></i>Aktiv tədris olunan fənlər
                    </small>
                </div>
            </div>
        </div>

        <!-- 4. Davamiyyət Faizi -->
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0 rounded-4 p-3 bg-white h-100 card-stat">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <span class="text-muted text-uppercase fw-bold small">Davamiyyət Faizi</span>
                        <h2 class="fw-bold @(Model.AttendancePercentage >= 75 ? "text-success" : "text-danger") mb-0 mt-1">
                            @Model.AttendancePercentage.ToString("0.#")%
                        </h2>
                    </div>
                    <div class="rounded-circle @(Model.AttendancePercentage >= 75 ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") p-3">
                        <i class="bi bi-calendar-check-fill fs-4"></i>
                    </div>
                </div>
                <div class="mt-auto">
                    <div class="d-flex justify-content-between small text-muted mb-1">
                        <span>İştirak: @Model.AttendedLessons / @Model.TotalLessons dərs</span>
                        <span class="@(Model.AttendancePercentage >= 75 ? "text-success" : "text-danger") fw-bold">
                            @(Model.AttendancePercentage >= 75 ? "Normal" : "Limit aşılır")
                        </span>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar @(Model.AttendancePercentage >= 75 ? "bg-success" : "bg-danger")" 
                             role="progressbar" style="width: @Model.AttendancePercentage%;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Əsas Məzmun Bloku: Kurslar və Elanlar -->
    <div class="row g-4">
        <!-- Cari Kurslar və Qiymət Statusu -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4 mb-4">
                <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-journal-text text-primary me-2"></i>Cari Kurslarım və Qiymət Vəziyyəti
                    </h5>
                    <a asp-action="Grades" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                        Bütün Qiymətlər <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
                <div class="card-body p-0">
                    @if (!Model.CurrentCourses.Any())
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-journal-x display-4 text-muted"></i>
                            <h6 class="text-muted mt-2">Hələ heç bir kursa yazılmamısınız.</h6>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4">Kod</th>
                                        <th>Kursun Adı</th>
                                        <th class="text-center">Kredit</th>
                                        <th>Müəllim</th>
                                        <th class="text-center">Yekun Bal</th>
                                        <th class="text-center">Hərf</th>
                                        <th class="pe-4 text-end">GPA</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var c in Model.CurrentCourses)
                                    {
                                        <tr>
                                            <td class="ps-4">
                                                <span class="badge bg-secondary font-monospace">@c.CourseCode</span>
                                            </td>
                                            <td class="fw-semibold text-dark">@c.CourseName</td>
                                            <td class="text-center">
                                                <span class="badge bg-light text-dark border">@c.Credits Kredit</span>
                                            </td>
                                            <td class="text-muted small">@c.TeacherName</td>
                                            <td class="text-center">
                                                @if (c.HasGrade && c.TotalScore.HasValue)
                                                {
                                                    <span class="fw-bold @(c.TotalScore.Value >= 51 ? "text-success" : "text-danger")">
                                                        @c.TotalScore.Value.ToString("0.##")
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-muted border">Davam edir</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                @if (c.HasGrade && !string.IsNullOrEmpty(c.LetterGrade))
                                                {
                                                    <span class="badge @(c.LetterGrade == "A" ? "bg-success" : c.LetterGrade == "B" ? "bg-primary" : c.LetterGrade == "C" ? "bg-info" : "bg-warning text-dark") px-2 py-1">
                                                        @c.LetterGrade
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td class="pe-4 text-end fw-bold">
                                                @(c.HasGrade && c.GradePoint.HasValue ? c.GradePoint.Value.ToString("0.00") : "-")
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Son Elanlar və GPA Şkalası Məlumatı -->
        <div class="col-lg-4">
            <!-- Son Elanlar Kartı -->
            <div class="card shadow-sm border-0 rounded-4 mb-4">
                <div class="card-header bg-white py-3 px-4 border-bottom">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-megaphone-fill text-warning me-2"></i>Son Elanlar
                    </h5>
                </div>
                <div class="card-body p-3">
                    @if (!Model.RecentAnnouncements.Any())
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-chat-dots fs-3 mb-2 d-block"></i>
                            Yeni elan yoxdur.
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var ann in Model.RecentAnnouncements)
                            {
                                <div class="list-group-item border-0 px-2 py-2 mb-2 bg-light rounded-3">
                                    <div class="d-flex w-100 justify-content-between align-items-center mb-1">
                                        <h6 class="fw-bold text-dark mb-0 text-truncate" style="max-width: 220px;" title="@ann.Title">
                                            @ann.Title
                                        </h6>
                                        <small class="text-muted" style="font-size: 0.75rem;">
                                            @ann.CreatedAt.ToString("dd.MM.yyyy")
                                        </small>
                                    </div>
                                    <p class="small text-muted mb-1 text-truncate-2">@ann.Content</p>
                                    <small class="text-primary" style="font-size: 0.75rem;">
                                        <i class="bi bi-person me-1"></i>@ann.AuthorName
                                        @if (!string.IsNullOrEmpty(ann.CourseName))
                                        {
                                            <span class="text-muted">(@ann.CourseName)</span>
                                        }
                                    </small>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- 4.0 GPA Şkalası Qaydası -->
            <div class="card shadow-sm border-0 rounded-4 bg-light">
                <div class="card-body p-3">
                    <h6 class="fw-bold text-dark mb-2">
                        <i class="bi bi-info-circle text-primary me-2"></i>GPA Hesablama Şkalası (4.0)
                    </h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-borderless small mb-0">
                            <tbody>
                                <tr>
                                    <td><span class="badge bg-success">A</span> 91 - 100</td>
                                    <td class="text-end fw-bold">4.00</td>
                                    <td class="text-muted">Əla</td>
                                </tr>
                                <tr>
                                    <td><span class="badge bg-primary">B</span> 81 - 90</td>
                                    <td class="text-end fw-bold">3.00</td>
                                    <td class="text-muted">Çox yaxşı</td>
                                </tr>
                                <tr>
                                    <td><span class="badge bg-info">C</span> 71 - 80</td>
                                    <td class="text-end fw-bold">2.00</td>
                                    <td class="text-muted">Yaxşı</td>
                                </tr>
                                <tr>
                                    <td><span class="badge bg-warning text-dark">D</span> 61 - 70</td>
                                    <td class="text-end fw-bold">1.50</td>
                                    <td class="text-muted">Kafi</td>
                                </tr>
                                <tr>
                                    <td><span class="badge bg-warning text-dark">E</span> 51 - 60</td>
                                    <td class="text-end fw-bold">1.00</td>
                                    <td class="text-muted">Qənaətbəxş</td>
                                </tr>
                                <tr>
                                    <td><span class="badge bg-danger">F</span> 0 - 50</td>
                                    <td class="text-end fw-bold">0.00</td>
                                    <td class="text-muted">Kəsr</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card-stat {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .card-stat:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 16px rgba(0,0,0,0.06) !important;
    }
    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
